{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "ChurchProjection Studio",
    "version":  "1.0.12",
    "identifier":  "org.churchprojection.studio",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "ChurchProjection Studio",
                                    "url":  "index.html",
                                    "width":  1440,
                                    "height":  900,
                                    "minWidth":  1080,
                                    "minHeight":  700,
                                    "center":  true,
                                    "decorations":  true
                                },
                                {
                                    "label":  "projection",
                                    "title":  "Projection Display",
                                    "url":  "projection.html",
                                    "width":  1280,
                                    "height":  720,
                                    "visible":  false,
                                    "decorations":  true,
                                    "skipTaskbar":  false
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027 asset: http://asset.localhost; img-src \u0027self\u0027 asset: http://asset.localhost data: blob:; media-src \u0027self\u0027 asset: http://asset.localhost blob:; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; script-src \u0027self\u0027"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis",
                                   "msi"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.ico"
                            ]
               }
}